{
  "name": "adaptive-learning-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run build:mcp && next build",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "start": "next start --hostname 127.0.0.1",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:mcp && tsx --test tests/*.test.ts",
    "smoke:mcp": "npm run build:mcp && tsx scripts/mcp-smoke.ts",
    "smoke:browser": "npm run build:mcp && tsx scripts/mcp-smoke.ts --browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.4.1",
    "json-logic-js": "^2.0.5",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "safe-regex2": "^5.1.2",
    "shell-quote": "^1.12.0",
    "simple-statistics": "^7.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shell-quote": "^1.7.5",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
